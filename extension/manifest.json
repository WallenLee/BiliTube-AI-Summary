{
  "manifest_version": 3,
  "name": "AI 视频总结与思维导图助手",
  "version": "1.2.3",
  "description": "一键将 B站、YouTube 等视频内容总结为 Markdown 文档与 Markmap 交互思维导图，支持时间戳精准联动播放。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开视频总结助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.youtube.com/*",
        "*://*.youtu.be/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ]
}
